SURE_SERVER_URL=http://YOUR_SURE_SERVER_IP:3000
SURE_API_KEY=YOUR_SURE_API_KEY



UP_BANK_ACCESS_TOKEN=up:yeah:YOUR_UP_BANK_PERSONAL_ACCESS_TOKEN
UP_BANK_SYNC_START=# Date & time in rfc-3339 format YYYY-MM-DDTHH:MM:SS[Z or +HH:MM]

CRON_SCHEDULE="0 * * * *" # "0 * * * *" = every hour, "0 0 * * *" = daily

UTC_TIMEZONE_OFFSET=0 # Defaults to 0. Set your local UTC offset: AEST=10, AEDT=11, AWST=8, NZ=12. Without this, transactions near midnight may be dated a day earlier than Up Bank shows.

# Map Up Bank account IDs (left) to Sure account IDs (right)
# Run npm run setup to generate this automatically.
UP_ACCOUNT_MAPPING='{}'

DATA_PATH=./imported_ids.json # Path to the local deduplication tracking file
